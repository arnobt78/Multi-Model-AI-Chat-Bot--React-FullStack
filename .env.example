# Server-side AI keys (never use VITE_ prefix — those leak into the browser bundle)
# Get keys: Google AI Studio, Groq Console, OpenRouter Keys, HF Access Tokens, OpenAI Platform
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=

# Optional public app URL (OpenRouter HTTP-Referer)
APP_URL=https://multi-ai-chat-hub.vercel.app

# PostgreSQL for Insights analytics — Coolify VPS (or any Postgres) connection string
# Chat history is NOT stored here (browser localStorage only)
DATABASE_URL=

# -----------------------------------------------------------------------------
# Sentry (optional) — Vite + Vercel Functions (NOT Next.js)
# Disabled when DSNs are empty. Client events use same-origin tunnel POST /api/monitoring
# so ad blockers that block *.ingest.sentry.io do not drop events.
#
# Rename note: NEXT_PUBLIC_SENTRY_DSN is Next-only and ignored by Vite.
# On Vercel, set VITE_SENTRY_DSN for Production (must be present at BUILD time).
# -----------------------------------------------------------------------------

# Client DSN (public) — Sentry → Project Settings → Client Keys (DSN)
# Example: https://<key>@o<orgId>.ingest.sentry.io/<projectId>
VITE_SENTRY_DSN=
# Deprecated alias (still read if VITE_SENTRY_DSN empty): VITE_PUBLIC_SENTRY_DSN=

# Server DSN — same Client Keys DSN, or leave blank to fall back to VITE_SENTRY_DSN
# Used by api/* capture + tunnel allowlist
SENTRY_DSN=

# Source map upload (build/CI only) — leave blank to skip upload
# Org slug: Sentry → Settings → General → Organization slug (NOT the project name)
SENTRY_ORG=
# Project slug: Sentry → Project Settings → General → Project slug (often NOT the org slug)
SENTRY_PROJECT=
# Auth token: Sentry → Settings → Auth Tokens — scopes: project:releases, org:read
SENTRY_AUTH_TOKEN=
